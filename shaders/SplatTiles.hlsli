// SplatTiles.hlsli
//
// Tile binning: which 16x16 screen tiles each splat touches, as a list of
// (tile, splat) pairs grouped by tile.
//
// The pairs are generated by walking the depth-sorted splats in order, so they
// start out in depth order. Sorting them by tile id with the same stable radix
// sort therefore leaves every tile's slice still in depth order, far to near,
// and no depth has to be packed into the key. The rasteriser walks each slice
// backwards to composite near to far.

#ifndef R4D_SPLATTILES_HLSLI
#define R4D_SPLATTILES_HLSLI

#include "Splat.hlsli"
#include "SplatSort.hlsli"

#define R4D_TILE_SIZE 16

// A splat covering more tiles than this is clipped to them. Only a splat with
// a huge screen-space radius reaches it, and those are the ones a frustum-wide
// covariance produces.
#define R4D_MAX_TILES_PER_SPLAT 1024u

// Per sorted position: how many tiles that splat touches, and where its pairs
// start. Indexed by position in the depth order, not by splat index.
RWStructuredBuffer<uint> g_tileCounts  : register(u7);
RWStructuredBuffer<uint> g_tileOffsets : register(u8);
// The scan scratch the pair total comes out of is declared in SplatSort.hlsli,
// where the radix kernels that size themselves from it can see it.

// The pairs themselves, ping-ponged by the tile sort exactly as the depth sort
// ping-pongs its keys.
RWStructuredBuffer<uint> g_pairTileA  : register(u10);
RWStructuredBuffer<uint> g_pairTileB  : register(u11);
RWStructuredBuffer<uint> g_pairSplatA : register(u12);
RWStructuredBuffer<uint> g_pairSplatB : register(u13);

// Two entries per tile: first pair and one past the last.
RWStructuredBuffer<uint> g_tileRanges : register(u14);

uint2 splatTileGrid(float2 viewport)
{
    return uint2((uint(viewport.x) + R4D_TILE_SIZE - 1u) / R4D_TILE_SIZE,
                 (uint(viewport.y) + R4D_TILE_SIZE - 1u) / R4D_TILE_SIZE);
}

// The inclusive tile span of a splat's quad, clamped to the grid. Returns false
// when the splat covers no tile at all.
bool splatTileSpan(SplatProjection splat, float2 viewport, out uint4 span)
{
    span = uint4(0u, 0u, 0u, 0u);
    if (splat.radius <= 0.0f)
    {
        return false;
    }

    const uint2 grid = splatTileGrid(viewport);
    const float2 low = splat.screen - splat.radius;
    const float2 high = splat.screen + splat.radius;

    if (high.x < 0.0f || high.y < 0.0f || low.x > viewport.x || low.y > viewport.y)
    {
        return false;
    }

    const int2 minTile = int2(floor(max(low, 0.0f.xx) / R4D_TILE_SIZE));
    const int2 maxTile = int2(floor(min(high, viewport - 1.0f.xx) / R4D_TILE_SIZE));
    if (maxTile.x < minTile.x || maxTile.y < minTile.y)
    {
        return false;
    }

    span = uint4(uint(minTile.x), uint(minTile.y),
                 min(uint(maxTile.x), grid.x - 1u), min(uint(maxTile.y), grid.y - 1u));
    return true;
}

uint splatTileSpanCount(uint4 span)
{
    return (span.z - span.x + 1u) * (span.w - span.y + 1u);
}

#endif
